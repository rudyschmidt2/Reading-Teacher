# Natural teacher voice (OpenAI gpt-4o-mini-tts). Required for kid voiceover.
OPENAI_API_KEY=

# Alternative if OPENAI_API_KEY is unset (Vercel AI Gateway).
# AI_GATEWAY_API_KEY=

# Optional. Default coral — warm, not cartoon.
# READING_TEACHER_VOICE=coral

# Optional. Default gpt-4o-mini-tts (use openai/gpt-4o-mini-tts with the gateway).
# READING_TEACHER_TTS_MODEL=gpt-4o-mini-tts
