{
  "name": "reading-teacher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check": "for f in scripts/check-*.mjs; do node --experimental-strip-types \"$f\" || exit 1; done",
    "smoke": "node --experimental-strip-types scripts/smoke.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
